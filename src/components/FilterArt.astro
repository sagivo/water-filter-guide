---
// Stylized water-filter illustration used when no licensed product photo exists
// in src/assets/filters/. Tank systems get a tall media tank; cartridge
// systems get Big Blue housings.
import type { FilterModel } from "../data/models";

interface Props {
  model: FilterModel;
  size?: number;
}
const { model: m, size = 96 } = Astro.props;

const COLORS: Record<string, [string, string]> = {
  SpringWell: ["#0a3a55", "#1d9fd1"],
  Aquasana: ["#0e5f8a", "#38bdf8"],
  "Kind Water": ["#0f4f70", "#7ee0d2"],
  iSpring: ["#123a5c", "#60a5fa"],
  "Express Water": ["#164e63", "#22d3ee"],
  APEC: ["#1e3a5f", "#818cf8"],
  "Pelican (Pentair)": ["#0c4a6e", "#34d399"],
  SoftPro: ["#155e75", "#2dd4bf"],
};
const [body, accent] = COLORS[m.brand] ?? ["#0a3a55", "#1d9fd1"];
const tank = m.capacityGallons >= 500000;
const uid = m.id.replace(/[^a-z0-9]/g, "");
---

<svg
  class="filter-art"
  width={size}
  height={size}
  viewBox="0 0 120 120"
  role="img"
  aria-label={`Illustration of the ${m.name}`}
>
  <defs>
    <linearGradient id={`fa-${uid}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={accent} stop-opacity="0.9" />
      <stop offset="1" stop-color={body} stop-opacity="0.95" />
    </linearGradient>
  </defs>
  {tank ? (
    <>
      <rect x="38" y="18" width="44" height="84" rx="22" fill={`url(#fa-${uid})`} />
      <rect x="38" y="18" width="44" height="84" rx="22" fill="none" stroke={accent} stroke-opacity="0.5" stroke-width="2" />
      <rect x="52" y="8" width="16" height="12" rx="3" fill={body} />
      <path d="M46 60 q8 -10 16 0 q8 10 16 0" stroke="#ffffff" stroke-opacity="0.55" stroke-width="3" fill="none" stroke-linecap="round" />
      <path d="M46 74 q8 -10 16 0 q8 10 16 0" stroke="#ffffff" stroke-opacity="0.35" stroke-width="3" fill="none" stroke-linecap="round" />
      <circle cx="60" cy="42" r="5" fill="#ffffff" opacity="0.7" />
    </>
  ) : (
    <>
      {[34, 52, 70].map((x) => (
        <g>
          <rect x={x} y="24" width="14" height="72" rx="7" fill={`url(#fa-${uid})`} />
          <rect x={x - 2} y="18" width="18" height="8" rx="3" fill={body} />
          <path d={`M${x + 3} 50 q4 -6 8 0`} stroke="#ffffff" stroke-opacity="0.5" stroke-width="2.5" fill="none" stroke-linecap="round" />
          <path d={`M${x + 3} 62 q4 -6 8 0`} stroke="#ffffff" stroke-opacity="0.3" stroke-width="2.5" fill="none" stroke-linecap="round" />
        </g>
      ))}
      <rect x="28" y="98" width="64" height="6" rx="3" fill={body} opacity="0.6" />
    </>
  )}
</svg>
