---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { AFFILIATE_REL, amazonLink } from "../lib/amazon";
import { MODELS } from "../data/models";
import { SITE_URL } from "../lib/site";
import { breadcrumbLd, type Crumb } from "../lib/schema";

const crumbs: Crumb[] = [
  { name: "Home", href: "/" },
  { name: "Test kits & replacements", href: "/accessories/" },
];

const TEST_KITS = [
  { name: "Tap Score Advanced City Water Test", query: "Tap Score advanced city water test kit", why: "Mail-in lab test covering 100+ contaminants including PFAS, lead and heavy metals — the test we recommend before buying any system." },
  { name: "MyWaterTest Well Water Test Kit", query: "mail-in well water test kit iron manganese", why: "Well-focused panel: iron, manganese, hardness, pH and bacteria. Buy the filter after the test, not before." },
  { name: "Hach 5-in-1 Test Strips", query: "Hach 5 in 1 water test strips", why: "Cheap strip test for chlorine, hardness, pH, nitrates and nitrites — good enough for a quick sanity check." },
  { name: "Digital TDS Meter", query: "TDS meter water tester digital", why: "Total dissolved solids won't tell you what's in the water, but a before/after reading shows whether your system is doing anything." },
];

const jsonLd = [
  breadcrumbLd(crumbs),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Water test kits & replacement filters",
    url: `${SITE_URL}/accessories/`,
  },
];
---

<BaseLayout
  title="Water Test Kits & Replacement Filters"
  description="The supplies that make a whole-house filter work: mail-in water test kits, quick test strips, and replacement filter packs for the systems we recommend."
  canonical={`${SITE_URL}/accessories/`}
  jsonLd={jsonLd}
>
  <div class="wrap wide">
    <Breadcrumbs crumbs={crumbs} />
    <div class="calc-hero" data-pagefind-body>
      <h1>Water test kits & replacement filters</h1>
      <p>Test first, filter second. These are the kits and supplies that pair with the systems we review — all sold on Amazon.</p>
    </div>

    <section class="acc-section">
      <div class="section-head"><h2 class="section-title">Test your water first</h2></div>
      <p class="acc-intro">A $30–$200 test beats a $1,500 guess. These are the kits we point readers to before they buy anything.</p>
      <div class="acc-grid">
        {TEST_KITS.map((k) => (
          <div class="acc-card">
            <h3>{k.name}</h3>
            <p>{k.why}</p>
            <a class="btn btn-xs buy" href={amazonLink(k.query)} rel={AFFILIATE_REL} target="_blank">Check price on Amazon</a>
          </div>
        ))}
      </div>
    </section>

    <section class="acc-section">
      <div class="section-head"><h2 class="section-title">Replacement filters by system</h2></div>
      <p class="acc-intro">Cartridge systems live or die by their replacement schedule. These are the packs our cost calculator uses.</p>
      <div class="acc-grid">
        {MODELS.filter((m) => m.annualFilterCost != null && m.annualFilterCost >= 100).map((m) => (
          <div class="acc-card">
            <h3>{m.brand} {m.shortName} replacement filters</h3>
            <p>About ${m.annualFilterCost}/yr. {m.filterLife}.</p>
            <a class="btn btn-xs buy" href={amazonLink(`${m.brand} ${m.shortName} replacement filter`)} rel={AFFILIATE_REL} target="_blank">Check price on Amazon</a>
          </div>
        ))}
      </div>
      <p class="fine" style="margin-top:1rem;">Tank systems (SpringWell CF1/CF4, Aquasana Rhino, SoftPro) need only a cheap sediment pre-filter yearly — their main media lasts a decade.</p>
    </section>
  </div>
</BaseLayout>
