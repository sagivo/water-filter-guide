---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, SITE_URL } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: `${SITE_URL}/about/`,
  name: `About ${SITE_NAME}`,
};
---

<BaseLayout title="About" description={`About ${SITE_NAME}: an independent, research-based buyer's guide to whole-house water filtration, with comparisons, calculators and transparent scoring.`} canonical={`${SITE_URL}/about/`} jsonLd={jsonLd}>
  <div class="wrap">
    <article class="prose">
      <h1>About {SITE_NAME}</h1>
      <p>
        {SITE_NAME} is an independent buyer's guide to whole-house water filtration —
        the point-of-entry systems that treat water where the main line enters your home,
        so every tap gets filtered water. We publish detailed comparisons, flow-rate sizers,
        and cost calculators so you can buy the right system the first time.
      </p>
      <h2>How we research</h2>
      <p>
        We compile manufacturer specifications, certification listings, professional reviews,
        and owner feedback, then cross-check claims (like flow ratings and filter life)
        across multiple sources. Specs and prices change, so we mark them as
        approximate and always recommend verifying on the retailer page before buying.
        The full process, including how our 10-point scores work, is on our
        <a href="/how-we-research/">how we research</a> page.
      </p>
      <h2>How we make money</h2>
      <p>
        {SITE_NAME} participates in the Amazon Services LLC Associates Program. When
        you click a product link and buy, we may earn a commission at no extra cost
        to you. This funds our research and free calculator tools. Commissions never
        decide which products we recommend or how they rank.
      </p>
    </article>
  </div>
</BaseLayout>
