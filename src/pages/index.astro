---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import PostCard from "../components/PostCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import ProductImage from "../components/ProductImage.astro";
import BuyButton from "../components/BuyButton.astro";
import StickyCta from "../components/StickyCta.astro";
import PriceTier from "../components/PriceTier.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
import { MODELS, getModel, priceTier, formatPrice } from "../data/models";
import { getPosts } from "../lib/posts";
import { websiteLd, faqLd, itemListLd } from "../lib/schema";
import { HOME_PICKS } from "../data/picks";

const posts = await getPosts();
const latest = [...posts].sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()
);
const guides = latest.filter((p) => p.data.category !== "best").slice(0, 6);
const topModels = [...MODELS].sort((a, b) => b.score - a.score).slice(0, 6);
const picks = HOME_PICKS.map((p) => ({ ...p, model: getModel(p.id) }));

const top = picks[0].model;
// Award colours for the four homepage picks.
const ACCENTS = ["#7ee0d2", "#38bdf8", "#2dd4bf", "#ffd34f"];

// Each need tile shows the #1 pick from its guide, so readers can buy straight from the homepage.
const needTypes = [
  { slug: "pfas-forever-chemicals-filter-guide", icon: "🧪", title: "PFAS & \"forever chemicals\"", text: "Which systems are actually certified to reduce PFAS." },
  { slug: "well-water-iron-manganese-guide", icon: "🚰", title: "Well water", text: "Iron, manganese and sulfur smell need different media." },
  { slug: "best-whole-house-water-filters-2026", icon: "💵", title: "On a budget", text: "Real whole-house filtration starting around $450." },
  { slug: "how-to-choose-whole-house-water-filter", icon: "📐", title: "Sizing your system", text: "Match flow rate (GPM) to your bathrooms, not your hopes." },
  { slug: "salt-free-softener-vs-filter", icon: "🧂", title: "Hard water", text: "Filters vs. softeners vs. salt-free conditioners, explained." },
  { slug: "springwell-cf1-vs-aquasana-rhino", icon: "⚖️", title: "Top head-to-head", text: "SpringWell CF1 vs. Aquasana Rhino, spec by spec." },
].map((y) => {
  const first = posts.find((p) => p.id === y.slug)?.data.picks?.[0];
  return { ...y, href: `/posts/${y.slug}/`, pick: first ? getModel(first.id) : undefined };
});

const faq = [
  {
    q: "What is the best whole-house water filter in 2026?",
    a: `It depends on your water. Our top-rated pick overall is the ${picks[0].model.name}. If PFAS is your concern, choose a system with independent NSF/ANSI 53 certification; for well water with iron, you need different media than city-water carbon. Our best whole-house water filters guide ranks them by need.`,
  },
  {
    q: "Do whole-house water filters remove PFAS?",
    a: "Some do, but check the certification, not the marketing. Look for WQA or NSF certification to NSF/ANSI 53 specifically listing PFOA/PFOS. Component-level marks are weaker than whole-system certification.",
  },
  {
    q: "How much does a whole-house water filter cost?",
    a: "Budget cartridge systems start around $450, mid-range tank systems run about $1,000–$1,500, and premium systems with PFAS certification or salt-free conditioning cost $2,000–$3,000+. The sticker price isn't the whole story — our cost calculator adds five years of filter replacements.",
  },
  {
    q: "Will a whole-house filter soften my water?",
    a: "No — filters remove contaminants, not hardness minerals. For hard water you need a salt-based softener or a salt-free conditioner (which prevents scale without removing minerals). Some systems, like the Pelican PSE2000, combine both.",
  },
];

const jsonLd = [websiteLd(), itemListLd("Top whole-house water filters of 2026", picks.map((p) => p.model)), faqLd(faq)];
const topTier = priceTier(top);
---

<BaseLayout
  title={`${SITE_NAME}: Best Whole House Water Filters of 2026, Compared`}
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
  hidePromo
>
  <section class="hero">
    <div class="wrap wide hero-grid">
      <div>
        <span class="hero-kicker"><span class="dot" aria-hidden="true"></span>Updated October 2026</span>
        <h1>The best whole-house water filters of 2026, <em>ranked.</em></h1>
        <p class="lead">
          We compared {MODELS.length} whole-house filtration systems on flow rate, media capacity,
          certifications and true 5-year cost, so you can stop guessing and start drinking better water.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/posts/best-whole-house-water-filters-2026/">See the ranking</a>
          <a class="btn secondary btn-lg" href="#match">Size my system</a>
        </div>
        <div class="hero-proof">
          <div><strong>{MODELS.length}</strong><span>systems compared</span></div>
          <div><strong>{new Set(MODELS.map((m) => m.brand)).size}</strong><span>brands compared</span></div>
          <div><strong>0</strong><span>lab coats required</span></div>
        </div>
      </div>

      <aside class="spotlight" aria-label="Our top pick">
        <div class="sp-ribbon"><span>🏆 #1 {picks[0].label}</span><span>2026</span></div>
        <div class="sp-media"><ProductImage model={top} size={260} eager /></div>
        <div class="sp-body">
          <h2 class="sp-name"><a href={`/filters/${top.id}/`}>{top.name}</a></h2>
          <div class="sp-meta">
            <span class="ring" style={`--v:${top.score * 10}`}><span>{top.score.toFixed(1)}</span></span>
            <span class="ring-label"><strong>Guide score</strong>out of 10</span>
            <span class="sp-price"><PriceTier model={top} label={false} /><small>{topTier ? `${topTier.label} price tier` : "check price"}</small></span>
          </div>
          <ul class="sp-points">{top.pros.slice(0, 3).map((p) => <li>{p}</li>)}</ul>
          <BuyButton model={top} size="lg" block />
          <div class="sp-links">
            <a href={`/filters/${top.id}/`}>Read the review →</a>
            <a href="/filters/">Compare all {MODELS.length}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="trust-bar" aria-label="Why readers trust us">
    <ul>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Commissions never decide rankings</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs cross-checked across sources</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs refreshed October 2026</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V9M12 19V5M19 19v-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Free sizing &amp; cost calculators</li>
    </ul>
  </section>

  <div class="wrap wide">
    <div class="section-head">
      <div>
        <span class="eyebrow">Editor's picks</span>
        <h2 class="section-title">The 4 water filters we'd buy in 2026</h2>
        <p class="section-sub">One clear winner for each kind of home. Tap a card for the full review.</p>
      </div>
      <a class="section-link" href="/posts/best-whole-house-water-filters-2026/">Full ranking →</a>
    </div>
    <div class="tp-grid four">
      {picks.map((p, i) => <ProductCard model={p.model} label={p.label} featured={i === 0} accent={ACCENTS[i]} />)}
    </div>
    <p class="swipe-hint">Swipe for more picks →</p>

    <form class="matcher" id="match" action="/tools/flow-sizer/" method="get">
      <div>
        <span class="eyebrow" style="color:var(--ink)">60-second sizer</span>
        <h2>What flow rate does your home need?</h2>
        <p>Two quick answers and we'll show the systems rated for your bathrooms and water source, with headroom built in.</p>
      </div>
      <div class="mq">
        <fieldset>
          <legend>How many bathrooms?</legend>
          <div class="mq-opts">
            <label><input type="radio" name="baths" value="1" /><span>1</span></label>
            <label><input type="radio" name="baths" value="2" checked /><span>2</span></label>
            <label><input type="radio" name="baths" value="3" /><span>3</span></label>
            <label><input type="radio" name="baths" value="5" /><span>4+</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Water source?</legend>
          <div class="mq-opts">
            <label><input type="radio" name="source" value="city" checked /><span>City water</span></label>
            <label><input type="radio" name="source" value="well" /><span>Well water</span></label>
          </div>
        </fieldset>
        <button class="btn dark btn-lg" type="submit">Show my matches →</button>
      </div>
    </form>

    <div class="section-head">
      <div>
        <span class="eyebrow">Shop by need</span>
        <h2 class="section-title">Best filter for your water problem</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="yard-grid">
      {needTypes.map((y) => (
        <div class="yard">
          <div class="yard-top">
            <div class="yard-icon" aria-hidden="true">{y.icon}</div>
            <h3><a href={y.href}>{y.title}</a></h3>
          </div>
          <p>{y.text}</p>
          {y.pick && (
            <div class="yard-pick">
              <span><small>Top pick</small><strong>{y.pick.shortName}</strong></span>
              <BuyButton model={y.pick} label="Check price" size="sm" />
            </div>
          )}
          <span class="go">Read the guide</span>
        </div>
      ))}
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Side by side</span>
        <h2 class="section-title">Highest-rated systems at a glance</h2>
      </div>
      <a class="section-link" href="/filters/">Compare all {MODELS.length} →</a>
    </div>
    <ComparisonTable models={topModels} />

    <div class="section-head">
      <div>
        <span class="eyebrow">Free tools</span>
        <h2 class="section-title">Don't guess. Calculate.</h2>
      </div>
      <a class="section-link" href="/tools/">All tools →</a>
    </div>
    <div class="tool-grid">
      <a class="tool-card" href="/tools/flow-sizer/">
        <div class="tool-icon">🚿</div>
        <h3>Flow-Rate Sizer</h3>
        <p>Enter your bathrooms and water source to get the systems rated for your peak demand.</p>
        <span class="go">Size my system</span>
      </a>
      <a class="tool-card" href="/tools/cost-calculator/">
        <div class="tool-icon">💰</div>
        <h3>5-Year Cost Calculator</h3>
        <p>Upfront price plus filter replacements — the true cost of every system we track.</p>
        <span class="go">Do the math</span>
      </a>
      <a class="tool-card" href="/tools/water-test-guide/">
        <div class="tool-icon">🧪</div>
        <h3>Water Test Interpreter</h3>
        <p>Got a water test back? Enter your contaminants and get the right system type.</p>
        <span class="go">Interpret my test</span>
      </a>
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Buying advice</span>
        <h2 class="section-title">Comparisons &amp; guides</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="post-grid">
      {guides.map((post) => <PostCard post={post} />)}
    </div>

    <section class="strip" aria-label="Why trust this guide">
      <div>
        <h2>Research you can actually check.</h2>
        <p>We earn a commission when you buy through our links, but it never changes which system we recommend.</p>
        <a class="btn" href="/how-we-research/">How we score filters</a>
      </div>
      <div class="strip-items">
        <div><div class="n">01</div><h3>Certification-first</h3><p>We rank independent NSF/ANSI certification above marketing claims, and say which is which.</p></div>
        <div><div class="n">02</div><h3>Specs, cross-checked</h3><p>Flow rates, capacities and filter costs verified across manufacturers, reviews and owner reports.</p></div>
        <div><div class="n">03</div><h3>True cost, not sticker</h3><p>Every recommendation prices five years of filter replacements, where budget systems really cost you.</p></div>
      </div>
    </section>

    <section class="faq home-faq" aria-label="Frequently asked questions">
      <h2 class="section-title">Water filter FAQ</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><div>{f.a}</div></details>)}
    </section>
  </div>

  <StickyCta model={top} label={`#1 ${picks[0].label}`} showAfter={1400} />
</BaseLayout>
